<UserControl x:Class="LifeGame.Desktop.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{Binding GameTitle}" FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text=" - " Foreground="{StaticResource TextSecondaryBrush}" FontSize="24"/>
            <TextBlock Text="{Binding CurrentDepth, StringFormat='第{0}章'}" 
                       Foreground="{StaticResource AccentBrush}" FontSize="24"/>
            <TextBlock Text="{Binding TotalTime, StringFormat=' | {0}分钟'}" 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SecondaryBrush}" 
                CornerRadius="10" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding StoryContent}" FontSize="16" 
                           Foreground="{StaticResource TextBrush}" 
                           TextWrapping="Wrap" LineHeight="28"/>
            </ScrollViewer>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Choices}" Margin="0,20,0,0"
                      Visibility="{Binding ShowChoices, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Text}" Style="{StaticResource OptionButtonStyle}" 
                            Width="500" HorizontalAlignment="Left"
                            Command="{Binding DataContext.MakeChoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="保存游戏" Style="{StaticResource OptionButtonStyle}" 
                    Width="120" Command="{Binding SaveGameCommand}"/>
            <Button Content="返回主菜单" Style="{StaticResource OptionButtonStyle}" 
                    Width="120" Command="{Binding BackToMenuCommand}"/>
        </StackPanel>

        <Border Grid.Row="0" Grid.RowSpan="4" Background="#CC000000" 
                Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="游戏结束" FontSize="36" FontWeight="Bold" 
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EndingTitle}" FontSize="28" 
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,10,0,30"/>
                <TextBlock Text="{Binding EndingType, StringFormat='结局类型: {0}'}" 
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <Button Content="重新开始" Style="{StaticResource PrimaryButtonStyle}" 
                            Width="150" Command="{Binding RestartCommand}"/>
                    <Button Content="返回主菜单" Style="{StaticResource PrimaryButtonStyle}" 
                            Width="150" Command="{Binding BackToMenuCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
