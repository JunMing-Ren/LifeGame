<UserControl x:Class="LifeGame.Desktop.Views.GameSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="创建新游戏" FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="SetupProgress" Minimum="1" Maximum="6" 
                         Value="{Binding CurrentStep}" Height="5" Margin="0,10,0,0"
                         Background="{StaticResource SecondaryBrush}" 
                         Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>

        <ContentControl Grid.Row="1" Margin="20">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel>
                                        <TextBlock Text="第一步：选择性别" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                                        <ItemsControl ItemsSource="{Binding GenderOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource OptionButtonStyle}" 
                                                            Width="300" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectGenderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel>
                                        <TextBlock Text="第二步：选择年龄" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                                        <ItemsControl ItemsSource="{Binding AgeOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource OptionButtonStyle}" 
                                                            Width="300" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectAgeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel>
                                        <TextBlock Text="第三步：选择背景" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                                        <ItemsControl ItemsSource="{Binding BackgroundOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource OptionButtonStyle}" 
                                                            Width="300" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel>
                                        <TextBlock Text="第四步：选择地点" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                                        <ItemsControl ItemsSource="{Binding LocationOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource OptionButtonStyle}" 
                                                            Width="300" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel>
                                        <TextBlock Text="第五步：选择主题" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                                        <ItemsControl ItemsSource="{Binding ThemeOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource OptionButtonStyle}" 
                                                            Width="300" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="6">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel>
                                        <TextBlock Text="第六步：自定义主题" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                                        <TextBox Text="{Binding CustomTheme, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="300" Height="100" TextWrapping="Wrap" 
                                                 AcceptsReturn="True" FontSize="14"
                                                 Background="{StaticResource SecondaryBrush}"
                                                 Foreground="{StaticResource TextBrush}"/>
                                        <Button Content="确认主题" Style="{StaticResource PrimaryButtonStyle}" 
                                                Width="200" Margin="0,20,0,0"
                                                Command="{Binding ConfirmCustomThemeCommand}"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="上一步" Style="{StaticResource OptionButtonStyle}" 
                    Width="120" Command="{Binding PreviousStepCommand}"
                    IsEnabled="{Binding CurrentStep, Converter={StaticResource StepToBoolConverter}, ConverterParameter=1, Mode=OneWay}"/>
            <Button Content="取消" Style="{StaticResource OptionButtonStyle}" 
                    Width="120" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#80000000" 
                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding GenerationStatus}" FontSize="20" 
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                <ProgressBar Value="{Binding GenerationProgress}" Width="300" Height="20" 
                             Margin="0,20,0,0" Background="{StaticResource SecondaryBrush}" 
                             Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
